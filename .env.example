# Browser build-time values used by ContactForm.tsx and local sanity tests.
# These are bundled into the static frontend at build time.
VITE_CRM_WEBHOOK_URL=https://app.timpsondrafting.com/api/webhooks/event
VITE_CRM_WEBHOOK_API_KEY=

# Optional local Cesium terrain viewer token. Keep the real value in .env.local.
VITE_CESIUM_ION_TOKEN=
