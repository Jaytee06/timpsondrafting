{
  "name": "vite-react-typescript-starter",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "generate:pages": "node scripts/generate-pages.mjs",
    "build:app": "vite build",
    "build:pages": "node scripts/generate-pages.mjs --output=dist",
    "build:cities": "node scripts/generate-city-pages.mjs",
    "build:sitemap": "node scripts/generate-sitemap.mjs",
    "build": "npm run build:app && npm run build:pages && npm run build:cities && npm run build:sitemap",
    "validate:cities": "node scripts/generate-city-pages.mjs --validate-only",
    "test:cities": "node --test scripts/tests/city-pages.test.mjs",
    "test:projects": "node --test scripts/tests/project-pages.test.mjs",
    "check:city-sources": "node scripts/check-city-code-sources.mjs",
    "audit:routes": "node scripts/audit-production-routes.mjs",
    "lint": "eslint .",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.app.json",
    "verify:sanity": "node scripts/sanity/timpson.mjs",
    "verify:sanity:live-api": "TIMPSON_LIVE_API_TEST=1 node scripts/sanity/timpson.mjs",
    "test:architecture": "rm -rf .architecture-test && tsc src/architecture/model.ts src/architecture/assemblies.ts src/architecture/registration.ts src/architecture/drawings.ts src/architecture/review.ts src/architecture/dimensions.ts src/architecture/openings.ts src/architecture/finishes.ts --outDir .architecture-test --module ES2022 --target ES2020 --skipLibCheck && node --test scripts/tests/architecture.test.mjs scripts/tests/assemblies.test.mjs scripts/tests/drawings.test.mjs scripts/tests/cad-adapter.test.mjs scripts/tests/review.test.mjs scripts/tests/dimensions.test.mjs scripts/tests/openings.test.mjs scripts/tests/finishes.test.mjs"
  },
  "dependencies": {
    "@react-three/drei": "^9.117.3",
    "@react-three/fiber": "^8.17.10",
    "@supabase/supabase-js": "^2.57.4",
    "cesium": "^1.145.0",
    "lucide-react": "^0.344.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "three": "^0.170.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.9.1",
    "@mlightcad/libredwg-web": "0.7.14",
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.18",
    "eslint": "^9.9.1",
    "eslint-plugin-react-hooks": "^5.1.0-rc.0",
    "eslint-plugin-react-refresh": "^0.4.11",
    "globals": "^15.9.0",
    "postcss": "^8.4.35",
    "tailwindcss": "^3.4.1",
    "typescript": "^5.5.3",
    "typescript-eslint": "^8.3.0",
    "vite": "^5.4.2",
    "vite-plugin-static-copy": "^1.0.6"
  }
}
